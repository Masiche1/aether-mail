driver = pgsql
connect = host=postgres dbname=aethermail user=aethermail password=aethermail
default_pass_scheme = ARGON2ID
password_query = SELECT CONCAT(m.local_part, '@', d.domain) AS user, m.password_hash AS password FROM mailboxes_mailbox m JOIN domains_sendingdomain d ON d.id = m.domain_id WHERE CONCAT(m.local_part, '@', d.domain) = '%u' AND m.status = 'active'
